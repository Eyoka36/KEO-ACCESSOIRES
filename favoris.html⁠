<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KEO Accessoires - Favoris</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        :root {
            --black: #111111;
            --white: #ffffff;
            --gold: #D4AF37;
            --light-bg: #fafafa;
            --gray: #777777;
            --border: #eeeeee;
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            --transition: 0.3s ease;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', sans-serif; background: var(--white); color: var(--black); line-height: 1.6; }
        h1 { font-family: 'Playfair Display', serif; }
        a { text-decoration: none; color: inherit; }

        .header {
            position: fixed; top: 0; left: 0; width: 100%; height: 80px;
            background: var(--white); display: flex; align-items: center; justify-content: space-between;
            padding: 0 7%; z-index: 1000; box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
        .logo { font-size: 26px; font-weight: 700; }
        .logo span { color: var(--gold); }
        nav { display: flex; gap: 30px; }
        nav a:hover { color: var(--gold); }

        .shop { padding: 120px 7% 60px; min-height: 80vh; }
        .shop h1 { font-size: 45px; text-align: center; margin-bottom: 40px; }

        .product-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px; }

        @media (max-width: 900px) {
            .header { padding: 0 20px; }
            nav { display: none; }
            .shop { padding-left: 20px; padding-right: 20px; }
            .shop h1 { font-size: 32px; }
        }
    </style>
</head>
<body>

    <header class="header">
        <div class="logo">KEO <span>Accessoires</span></div>
        <nav>
            <a href="index.html">Accueil</a>
            <a href="boutique.html">Boutique</a>
            <a href="panier.html">Panier</a>
        </nav>
    </header>

    <section class="shop">
        <h1>Mes favoris ❤️</h1>
        <div class="product-container" id="favoris-container">
            <!-- Contenu injecté dynamiquement via favoris.js -->
        </div>
    </section>

    <script src="js/favoris.js"></script>
</body>
</html>
