/* ===================================
   VARIABLES GLOBALES ET REINITIALISATION
   =================================== */
:root {
    --black: #111111;
    --white: #ffffff;
    --gold: #D4AF37;
    --gold-hover: #b5932b;
    --light-bg: #fafafa;
    --gray: #777777;
    --border: #eeeeee;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    --transition: 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background-color: var(--white);
    color: var(--black);
    line-height: 1.6;
}

h1, h2, h3, h4 {
    font-family: 'Playfair Display', serif;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: var(--transition);
}

/* ===================================
   HEADER & NAVIGATION
   =================================== */
.header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 80px;
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    z-index: 1000;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
}

.logo {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 1px;
}

.logo span {
    color: var(--gold);
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    font-size: 15px;
    font-weight: 500;
    transition: var(--transition);
}

nav a:hover {
    color: var(--gold);
}

.actions {
    display: flex;
    gap: 20px;
    font-size: 20px;
}

.actions a {
    position: relative;
    transition: var(--transition);
}

.actions a:hover {
    transform: scale(1.1);
}

/* ===================================
   SECTIONS GÉNÉRALES ET TITRES
   =================================== */
.shop, .cart-page, .contact, .story {
    padding: 120px 7% 60px;
    min-height: 80vh;
}

.shop h1, .cart-page h1, .contact h1, .story h1 {
    font-size: 45px;
    text-align: center;
    margin-bottom: 10px;
}

.shop p, .contact p {
    text-align: center;
    color: var(--gray);
    margin-bottom: 40px;
}

/* ===================================
   BOUTIQUE (RECHERCHE, CATÉGORIES, PRODUITS)
   =================================== */
.search-box {
    display: flex;
    justify-content: center;
    margin-bottom: 30px;
}

.search-box input {
    width: 100%;
    max-width: 500px;
    padding: 15px 25px;
    border: 1px solid var(--border);
    border-radius: 30px;
    font-size: 15px;
    outline: none;
    background: var(--light-bg);
    transition: var(--transition);
}

.search-box input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
}

.categories {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 50px;
}

.categories button {
    padding: 10px 25px;
    border: 1px solid var(--border);
    background: var(--white);
    border-radius: 25px;
    font-size: 14px;
    font-weight: 500;
}

.categories button:hover, .categories button.active {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
}

.product-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
}

.product-card {
    background: var(--white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow);
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--transition);
}

.product-card:hover {
    transform: translateY(-8px);
}

.product-card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 15px;
    margin-bottom: 15px;
}

.product-card h3 {
    font-size: 20px;
    margin-bottom: 10px;
}

.product-card .price {
    font-size: 18px;
    font-weight: 600;
    color: var(--gold);
    margin-bottom: 5px;
}

.product-card .stock {
    font-size: 13px;
    color: var(--gray);
    margin-bottom: 15px;
}

.product-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
}

.btn-favori {
    padding: 10px 15px;
    border: 1px solid var(--border);
    background: var(--light-bg);
    border-radius: 12px;
    font-size: 16px;
}

.btn-favori:hover {
    background: #ffe6e6;
    border-color: red;
}

.btn-panier {
    flex: 1;
    padding: 10px 20px;
    border: none;
    background: var(--black);
    color: var(--white);
    border-radius: 12px;
    font-weight: 500;
}

.btn-panier:hover {
    background: var(--gold);
}

/* ===================================
   PANIER (CART PAGE)
   =================================== */
#cart-container {
    max-width: 800px;
    margin: 0 auto 30px;
}

.cart-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    background: var(--light-bg);
    border-radius: 15px;
    margin-bottom: 15px;
}

#total {
    text-align: center;
    font-size: 28px;
    color: var(--gold);
    margin-bottom: 30px;
}

#order-whatsapp {
    display: block;
    margin: 0 auto;
    padding: 15px 40px;
    background: #25D366;
    color: var(--white);
    border: none;
    border-radius: 30px;
    font-size: 16px;
    font-weight: 600;
}

#order-whatsapp:hover {
    background: #1eb956;
    transform: translateY(-2px);
}

/* ===================================
   CONTACT & FORMULAIRES
   =================================== */
.contact-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
    margin-bottom: 60px;
}

.contact-card {
    padding: 30px;
    background: var(--light-bg);
    border-radius: 20px;
    text-align: center;
}

.contact-card h3 {
    margin-bottom: 10px;
    font-size: 22px;
}

.contact-card a {
    display: inline-block;
    margin-top: 15px;
    padding: 10px 25px;
    background: var(--black);
    color: var(--white);
    border-radius: 20px;
    font-size: 14px;
}

.contact-card a:hover {
    background: var(--gold);
}

.contact-form {
    max-width: 600px;
    margin: 0 auto 60px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.contact-form input, .contact-form textarea {
    width: 100%;
    padding: 15px 20px;
    border: 1px solid var(--border);
    border-radius: 15px;
    font-size: 15px;
    outline: none;
    background: var(--light-bg);
}

.contact-form textarea {
    height: 140px;
    resize: vertical;
}

.contact-form button {
    padding: 15px;
    background: var(--black);
    color: var(--white);
    border: none;
    border-radius: 30px;
    font-size: 16px;
    font-weight: 600;
}

.contact-form button:hover {
    background: var(--gold);
}

/* ===================================
   NOTRE HISTOIRE
   =================================== */
.story-content {
    max-width: 800px;
    margin: 0 auto 50px;
    text-align: center;
}

.story-content h2 {
    color: var(--gold);
    font-size: 24px;
    margin-bottom: 25px;
}

.story-content p {
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 20px;
}

.story .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.story .values div {
    padding: 35px;
    background: var(--light-bg);
    border-radius: 20px;
    text-align: center;
}

/* ===================================
   ASSISTANT IA
   =================================== */
.ai-button {
    position: fixed;
    left: 25px;
    bottom: 30px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    background: var(--black);
    color: var(--white);
    font-size: 25px;
    z-index: 999;
}

.ai-box {
    display: none;
    position: fixed;
    left: 25px;
    bottom: 100px;
    width: 280px;
    background: var(--white);
    padding: 25px;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    z-index: 999;
}

/* ===================================
   RESPONSIVE DESIGN (MOBILE)
   =================================== */
@media (max-width: 900px) {
    .header {
        padding: 0 20px;
    }
    
    nav {
        display: none;
    }
    
    .shop, .cart-page, .contact, .story {
        padding-left: 20px;
        padding-right: 20px;
    }

    .shop h1, .cart-page h1, .contact h1, .story h1 {
        font-size: 32px;
    }
}
